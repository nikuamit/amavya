{
  "rewrites": [
    { "source": "/sarkar", "destination": "/sarkar.html" },
    { "source": "/invest", "destination": "/#invest" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ]}
  ]
}
